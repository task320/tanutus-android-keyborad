<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Layout -->
    <dimen name="key_height">52dp</dimen>
    <dimen name="candidate_bar_height">44dp</dimen>
    <dimen name="key_label_text_size">18sp</dimen>
    <dimen name="candidate_text_size">16sp</dimen>
    <dimen name="key_gap">2dp</dimen>
    <dimen name="key_outline_width">2dp</dimen>

    <!--
      docs/keyboard-spec.md left these as "実装しながら調整する" (tune while
      building). Confirmed good on-device (Pixel 9a, 2026-08-22) at the values below —
      not placeholders.
    -->
    <dimen name="space_drag_threshold">24dp</dimen>
    <dimen name="space_tap_slop">12dp</dimen>

    <integer name="long_press_timeout_ms">500</integer>
    <integer name="backspace_repeat_interval_ms">60</integer>
    <!-- Shift lock: two taps within this window count as a double-tap. Matches Android's
         platform default (ViewConfiguration.getDoubleTapTimeout()). -->
    <integer name="double_tap_timeout_ms">300</integer>
</resources>
