<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      docs/keyboard-spec.md left the exact colors undecided
      ("視覚的フィードバックの具体的な配色"); these values were confirmed as final
      after on-device review (Pixel 9a, 2026-08-22) rather than left as placeholders.
    -->
    <color name="layer_base_background">#FF20232A</color>
    <color name="layer_symbol_background">#FF1F2A38</color>

    <color name="key_background_normal">#FF30343C</color>
    <color name="key_background_locked">#FF4C8BF5</color>
    <!-- Half the brightness of key_background_locked (per-channel /2), used only for the
         Shift key's lock fill so it reads as visually distinct from #12/A-toggle locks. -->
    <color name="key_background_shift_locked">#FF26457A</color>
    <!-- Momentary shift: midway between a normal key and the shift lock above, so "armed for
         one character" reads as weaker than "locked" rather than as another lock. -->
    <color name="key_background_shift_momentary">#FF2B3C5B</color>
    <!-- Zenkaku (full-width) is drawn as an outline, not a fill, because it is independent
         of the direct-alnum fill on the very same A/あ key — see KeyVisualState. Warm so it
         reads against both the normal grey and the blue lock underneath it. -->
    <color name="key_outline_zenkaku">#FFF5A623</color>
    <color name="key_text_normal">#FFF5F5F5</color>
    <color name="key_text_locked">#FFFFFFFF</color>

    <color name="candidate_bar_background">#FF15171B</color>
    <color name="candidate_text">#FFF5F5F5</color>
    <color name="candidate_selected_background">#FF4C8BF5</color>

    <color name="launcher_background">#FF20232A</color>
    <color name="launcher_foreground">#FF4C8BF5</color>
</resources>
